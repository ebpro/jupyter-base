{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Devcontainer Feature",
  "type": "object",
  "required": ["id", "version", "name"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$",
      "description": "Feature id (lowercase, numbers, dot, underscore, dash)"
    },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "provides": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requires": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supported_archs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "prebake_preferred": { "type": "boolean" }
  },
  "additionalProperties": false
}
