work
local

# Generated content (all generated files now in /generated/)
/generated/*
!generated/profiles/
/generated/profiles/*
!generated/profiles/.gitkeep
.envrc.local
build-logs

# ignore all python cache files subdirectories
**/__pycache__/

# python packaging artifacts
*.egg-info/

# python virtualenv
.venv/

# jupyter caches
.jupyter_cache/

# quarto build output
**/*_files/

# build logs and backup files
*.log
*.bak

# Toolcache staging dir: bind-only build input (see scripts/stage-toolcache.sh).
# The directory must exist in the build context; archives must never be
# committed nor reach any COPYed tree.
toolcache-stage/*
!toolcache-stage/.gitkeep

# Legacy toolcache staging path (pre-5120ad5): staging now lives in the
# bind-only toolcache-stage/; stale blobs here would bloat the COPYed layer.
artefacts/toolcache/
