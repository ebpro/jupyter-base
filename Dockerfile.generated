RUN --mount=type=bind,source=Artefacts,target=/tmp/Artefacts   bash -eux -c 'if [ -x /tmp/features/startup/install.sh ]; then /tmp/features/startup/install.sh; else echo "No install.sh for startup"; fi; rm -rf /tmp/features/startup'

# Feature: gh-cli
COPY .devcontainer/features/gh-cli /tmp/features/gh-cli
RUN --mount=type=bind,source=Artefacts,target=/tmp/Artefacts   bash -eux -c 'if [ -x /tmp/features/gh-cli/install.sh ]; then /tmp/features/gh-cli/install.sh; else echo "No install.sh for gh-cli"; fi; rm -rf /tmp/features/gh-cli'

