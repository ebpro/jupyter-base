# Generated multi-profile Dockerfile
ARG VARIANT="ubuntu-24.04"
# Use an explicit default base image tag to avoid buildx warnings when ARG has a default
FROM mcr.microsoft.com/devcontainers/base:ubuntu-24.04 AS base
ARG NB_USER=jovyan
ARG NB_UID=1001
ARG NB_GID=1001
ENV HOME=/home/jovyan
WORKDIR /home/jovyan

# Bake helper library and Artefacts into the base stage
COPY shared/_lib/helpers.sh /opt/solen/_lib/helpers.sh
COPY Artefacts /opt/solen/Artefacts
ENV FEATURE_HELPERS_DIR=/opt/solen/_lib ARTIFACTS_DIR=/opt/solen/Artefacts
RUN mkdir -p /opt/.features || true
# Profile: 00-00-base
FROM base AS profile-00-00-base
# Feature: user
COPY .devcontainer/features/user /tmp/features/user
RUN --mount=type=bind,source=Artefacts,target=/tmp/Artefacts   bash -eux -c 'if [ -x /tmp/features/user/install.sh ]; then /tmp/features/user/install.sh; else echo "No install.sh for user"; fi; rm -rf /tmp/features/user'

# Feature: base-apt
COPY .devcontainer/features/base-apt /tmp/features/base-apt
RUN --mount=type=bind,source=Artefacts,target=/tmp/Artefacts   bash -eux -c 'if [ -x /tmp/features/base-apt/install.sh ]; then /tmp/features/base-apt/install.sh; else echo "No install.sh for base-apt"; fi; rm -rf /tmp/features/base-apt'

# Feature: zsh-config
