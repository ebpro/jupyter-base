RUN --mount=type=bind,source=Artefacts,target=/tmp/Artefacts   bash -eux -c 'if [ -x /tmp/features/docker-cli-helper/install.sh ]; then /tmp/features/docker-cli-helper/install.sh; else echo "No install.sh for docker-cli-helper"; fi; rm -rf /tmp/features/docker-cli-helper'

# Feature: _lib/checksum-verify
COPY .devcontainer/features/_lib/checksum-verify /tmp/features/_lib/checksum-verify
RUN --mount=type=bind,source=Artefacts,target=/tmp/Artefacts   bash -eux -c 'if [ -x /tmp/features/_lib/checksum-verify/install.sh ]; then /tmp/features/_lib/checksum-verify/install.sh; else echo "No install.sh for _lib/checksum-verify"; fi; rm -rf /tmp/features/_lib/checksum-verify'

