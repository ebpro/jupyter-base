# --- Profile: full ---
FROM base AS profile-full
LABEL org.solen.profile="full" \
      org.solen.features.added="user gh git-lfs python-base kubernetes-client tilt base-apt docker-cli-helper java-sdkman jetbrains-gateway node podman prompt-helpers python-conda quarto-common startup zsh-config pip-requirements kubernetes-dev dev-tools texlive java-gradle java-jdk java-maven code-server python-lsp jupyter-base quarto-cli bundle-k8s bundle-base-full bundle-java-build codeserver-extensions bundle-dev-base jupyter-kernels quarto-python bundle-data-science bundle-quarto-base bundle-quarto-full" \
