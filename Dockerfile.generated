# Generated Dockerfile
ARG VARIANT="ubuntu-24.04"
FROM mcr.microsoft.com/devcontainers/base:${VARIANT} AS base
LABEL org.solen.vendor="Solen"
ARG NB_USER=jovyan
ARG NB_UID=1001
ARG NB_GID=1001
ENV HOME=/home/jovyan
WORKDIR /home/jovyan

COPY shared/_lib/helpers.sh /opt/solen/_lib/helpers.sh
COPY Artefacts /opt/solen/Artefacts
ENV FEATURE_HELPERS_DIR=/opt/solen/_lib ARTIFACTS_DIR=/opt/solen/Artefacts
RUN mkdir -p /opt/.features /scripts && \
    printf "source /opt/solen/_lib/helpers.sh || true" > /scripts/feature_helpers.sh

# --- Profile: cicd-teaching ---
FROM base AS profile-cicd-teaching
LABEL org.solen.profile="cicd-teaching" \
      org.solen.features.added="user gh git-lfs python-base tilt kubernetes-client base-apt docker-cli-helper node podman prompt-helpers startup zsh-config pip-requirements kubernetes-dev dev-tools python-lsp bundle-cicd-teaching bundle-base-full bundle-dev-base" \
      org.solen.features.provides="cicd-stack,gh,git-lfs,helm,k9s,kubectl,kustomize,node,npm,pip,pip-requirements,podman,python-lsp,python3,tilt"
RUN \
  --mount=type=bind,source=.devcontainer/features/user,target=/tmp/features/user,readonly \
  --mount=type=bind,source=.devcontainer/features/gh,target=/tmp/features/gh,readonly \
  --mount=type=bind,source=.devcontainer/features/git-lfs,target=/tmp/features/git-lfs,readonly \
  --mount=type=bind,source=.devcontainer/features/python-base,target=/tmp/features/python-base,readonly \
  --mount=type=bind,source=.devcontainer/features/tilt,target=/tmp/features/tilt,readonly \
  --mount=type=bind,source=.devcontainer/features/kubernetes-client,target=/tmp/features/kubernetes-client,readonly \
  --mount=type=bind,source=.devcontainer/features/base-apt,target=/tmp/features/base-apt,readonly \
  --mount=type=bind,source=.devcontainer/features/docker-cli-helper,target=/tmp/features/docker-cli-helper,readonly \
  --mount=type=bind,source=.devcontainer/features/node,target=/tmp/features/node,readonly \
  --mount=type=bind,source=.devcontainer/features/podman,target=/tmp/features/podman,readonly \
  --mount=type=bind,source=.devcontainer/features/prompt-helpers,target=/tmp/features/prompt-helpers,readonly \
  --mount=type=bind,source=.devcontainer/features/startup,target=/tmp/features/startup,readonly \
  --mount=type=bind,source=.devcontainer/features/zsh-config,target=/tmp/features/zsh-config,readonly \
  --mount=type=bind,source=.devcontainer/features/pip-requirements,target=/tmp/features/pip-requirements,readonly \
  --mount=type=bind,source=.devcontainer/features/kubernetes-dev,target=/tmp/features/kubernetes-dev,readonly \
  --mount=type=bind,source=.devcontainer/features/dev-tools,target=/tmp/features/dev-tools,readonly \
  --mount=type=bind,source=.devcontainer/features/python-lsp,target=/tmp/features/python-lsp,readonly \
  --mount=type=bind,source=.devcontainer/features/bundle-cicd-teaching,target=/tmp/features/bundle-cicd-teaching,readonly \
  --mount=type=bind,source=.devcontainer/features/bundle-base-full,target=/tmp/features/bundle-base-full,readonly \
  --mount=type=bind,source=.devcontainer/features/bundle-dev-base,target=/tmp/features/bundle-dev-base,readonly \
  --mount=type=bind,source=Artefacts,target=/tmp/Artefacts,readonly \
  --mount=type=bind,source=scripts,target=/tmp/scripts,readonly \
  --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  --mount=type=cache,target=/opt/toolcache,sharing=locked \
  --mount=type=cache,target=/root/.cache,sharing=locked \
  --mount=type=cache,target=/home/jovyan/.cache,sharing=locked,uid=1001,gid=1001 \
  bash -eux -o pipefail -c 'feats=("user" "gh" "git-lfs" "python-base" "tilt" "kubernetes-client" "base-apt" "docker-cli-helper" "node" "podman" "prompt-helpers" "startup" "zsh-config" "pip-requirements" "kubernetes-dev" "dev-tools" "python-lsp" "bundle-cicd-teaching" "bundle-base-full" "bundle-dev-base" ); for f in "${feats[@]}"; do \
    if [ -d "/tmp/features/$f" ]; then \
      chmod +x /tmp/features/$f/install.sh 2>/dev/null || true; \
      [ -f /tmp/features/$f/install.sh ] && { set +u; bash /tmp/features/$f/install.sh; set -u; }; \
    fi; \
  done; apt-get clean; rm -rf /var/lib/apt/lists/auxfiles /var/lib/apt/lists/lock /var/lib/apt/lists/partial'
FROM profile-cicd-teaching AS final-cicd-teaching

