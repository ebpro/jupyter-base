# Generated Dockerfile
ARG VARIANT="ubuntu-24.04"
FROM mcr.microsoft.com/devcontainers/base:${VARIANT} AS base
LABEL org.solen.vendor="Solen"
ARG NB_USER=jovyan
ARG NB_UID=1001
ARG NB_GID=1001
ENV HOME=/home/jovyan
WORKDIR /home/jovyan

COPY shared/_lib/helpers.sh /opt/solen/_lib/helpers.sh
COPY Artefacts /opt/solen/Artefacts
ENV FEATURE_HELPERS_DIR=/opt/solen/_lib ARTIFACTS_DIR=/opt/solen/Artefacts
RUN mkdir -p /opt/.features /scripts && \
    printf "source /opt/solen/_lib/helpers.sh || true" > /scripts/feature_helpers.sh
# Inject prebaked toolcache from repository
COPY Artefacts/toolcache /opt/toolcache
RUN chmod -R a+rX /opt/toolcache || true

# --- Profile: quarto-lecture-full ---
FROM base AS profile-quarto-lecture-full
LABEL org.solen.profile="quarto-lecture-full" \
      org.solen.features.added="user base-apt zsh-config _lib/download-release prompt-helpers startup gh-cli git-lfs docker-cli-helper python-base dev-tools _lib/checksum-verify _lib/toolcache node python-lsp pip-requirements python-conda jupyter-base jupyter-kernels quarto-cli quarto-python quarto-common texlive java-sdkman java-maven java-gradle java-jdk kubernetes-client kubernetes-dev tilt docker-cli docker-compose docker-buildx podman dive trivy hadolint buildah skopeo ctop" \
      org.solen.features.provides="buildah,ctop,dive,docker,docker-buildx,docker-compose,download_direct,download_github_release,gh,git-lfs,gradle,hadolint,helm,java,javac,jupyter,jupyterlab,k9s,kubectl,kustomize,maven,mvn,node,npm,pip,podman,python3,quarto-cli,quarto-python,sdkman,skopeo,tilt,trivy"
ENV INSTALL_NOTEBOOK_EXTENSIONS="True"
ENV JDK_VERSION="25"
RUN \
  --mount=type=bind,source=features/user,target=/tmp/features/user,readonly \
  --mount=type=bind,source=features/base-apt,target=/tmp/features/base-apt,readonly \
  --mount=type=bind,source=features/zsh-config,target=/tmp/features/zsh-config,readonly \
  --mount=type=bind,source=features/_lib/download-release,target=/tmp/features/_lib/download-release,readonly \
  --mount=type=bind,source=features/prompt-helpers,target=/tmp/features/prompt-helpers,readonly \
  --mount=type=bind,source=features/startup,target=/tmp/features/startup,readonly \
  --mount=type=bind,source=features/gh-cli,target=/tmp/features/gh-cli,readonly \
  --mount=type=bind,source=features/git-lfs,target=/tmp/features/git-lfs,readonly \
  --mount=type=bind,source=features/docker-cli-helper,target=/tmp/features/docker-cli-helper,readonly \
  --mount=type=bind,source=features/python-base,target=/tmp/features/python-base,readonly \
  --mount=type=bind,source=features/dev-tools,target=/tmp/features/dev-tools,readonly \
  --mount=type=bind,source=features/_lib/checksum-verify,target=/tmp/features/_lib/checksum-verify,readonly \
  --mount=type=bind,source=features/_lib/toolcache,target=/tmp/features/_lib/toolcache,readonly \
  --mount=type=bind,source=features/node,target=/tmp/features/node,readonly \
  --mount=type=bind,source=features/python-lsp,target=/tmp/features/python-lsp,readonly \
  --mount=type=bind,source=features/pip-requirements,target=/tmp/features/pip-requirements,readonly \
  --mount=type=bind,source=features/python-conda,target=/tmp/features/python-conda,readonly \
  --mount=type=bind,source=features/jupyter-base,target=/tmp/features/jupyter-base,readonly \
  --mount=type=bind,source=features/jupyter-kernels,target=/tmp/features/jupyter-kernels,readonly \
  --mount=type=bind,source=features/quarto-cli,target=/tmp/features/quarto-cli,readonly \
  --mount=type=bind,source=features/quarto-python,target=/tmp/features/quarto-python,readonly \
  --mount=type=bind,source=features/quarto-common,target=/tmp/features/quarto-common,readonly \
  --mount=type=bind,source=features/texlive,target=/tmp/features/texlive,readonly \
  --mount=type=bind,source=features/java-sdkman,target=/tmp/features/java-sdkman,readonly \
  --mount=type=bind,source=features/java-maven,target=/tmp/features/java-maven,readonly \
  --mount=type=bind,source=features/java-gradle,target=/tmp/features/java-gradle,readonly \
  --mount=type=bind,source=features/java-jdk,target=/tmp/features/java-jdk,readonly \
  --mount=type=bind,source=features/kubernetes-client,target=/tmp/features/kubernetes-client,readonly \
  --mount=type=bind,source=features/kubernetes-dev,target=/tmp/features/kubernetes-dev,readonly \
  --mount=type=bind,source=features/tilt,target=/tmp/features/tilt,readonly \
  --mount=type=bind,source=features/docker-cli,target=/tmp/features/docker-cli,readonly \
  --mount=type=bind,source=features/docker-compose,target=/tmp/features/docker-compose,readonly \
  --mount=type=bind,source=features/docker-buildx,target=/tmp/features/docker-buildx,readonly \
  --mount=type=bind,source=features/podman,target=/tmp/features/podman,readonly \
  --mount=type=bind,source=features/dive,target=/tmp/features/dive,readonly \
  --mount=type=bind,source=features/trivy,target=/tmp/features/trivy,readonly \
  --mount=type=bind,source=features/hadolint,target=/tmp/features/hadolint,readonly \
  --mount=type=bind,source=features/buildah,target=/tmp/features/buildah,readonly \
  --mount=type=bind,source=features/skopeo,target=/tmp/features/skopeo,readonly \
  --mount=type=bind,source=features/ctop,target=/tmp/features/ctop,readonly \
  --mount=type=bind,source=Artefacts,target=/tmp/Artefacts,readonly \
  --mount=type=bind,source=scripts,target=/tmp/scripts,readonly \
  --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  --mount=type=cache,target=/opt/toolcache,sharing=locked \
  --mount=type=cache,target=/root/.cache,sharing=locked \
  --mount=type=cache,target=/home/jovyan/.cache,sharing=locked,uid=1001,gid=1001 \
  bash -eux -o pipefail -c 'feats=("user" "base-apt" "zsh-config" "_lib/download-release" "prompt-helpers" "startup" "gh-cli" "git-lfs" "docker-cli-helper" "python-base" "dev-tools" "_lib/checksum-verify" "_lib/toolcache" "node" "python-lsp" "pip-requirements" "python-conda" "jupyter-base" "jupyter-kernels" "quarto-cli" "quarto-python" "quarto-common" "texlive" "java-sdkman" "java-maven" "java-gradle" "java-jdk" "kubernetes-client" "kubernetes-dev" "tilt" "docker-cli" "docker-compose" "docker-buildx" "podman" "dive" "trivy" "hadolint" "buildah" "skopeo" "ctop" ); for f in "${feats[@]}"; do \
    if [ -d "/tmp/features/$f" ]; then \
      chmod +x /tmp/features/$f/install.sh 2>/dev/null || true; \
      [ -f /tmp/features/$f/install.sh ] && { set +u; bash /tmp/features/$f/install.sh; set -u; }; \
    fi; \
  done; apt-get clean; rm -rf /var/lib/apt/lists/auxfiles /var/lib/apt/lists/lock /var/lib/apt/lists/partial'
FROM profile-quarto-lecture-full AS final
