RUN --mount=type=bind,source=Artefacts,target=/tmp/Artefacts   bash -eux -c 'if [ -x /tmp/features/prompt-helpers/install.sh ]; then /tmp/features/prompt-helpers/install.sh; else echo "No install.sh for prompt-helpers"; fi; rm -rf /tmp/features/prompt-helpers'

# Feature: startup
