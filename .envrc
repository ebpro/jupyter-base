#!/usr/bin/env bash
# Project direnv file: load GITHUB_TOKEN from gopass, fall back to `gh auth token`.
# This file is safe to commit because it does not contain secrets; it only
# attempts to read them from `gopass` or `gh` at runtime.

# Try gopass first
if command -v gopass >/dev/null 2>&1; then
  # common paths: `github/token`, `secret/github/token` — adapt as needed
  GITHUB_TOKEN="$(gopass show -o github/token 2>/dev/null || gopass show -o secret/github/token 2>/dev/null || true)"
fi

# If gopass didn't yield a token, try `gh auth token` (if gh CLI is available)
if [ -z "$GITHUB_TOKEN" ] && command -v gh >/dev/null 2>&1; then
  GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"
fi

# Export if we have one
if [ -n "$GITHUB_TOKEN" ]; then
  export GITHUB_TOKEN
fi

# Do not dump sensitive values in the shell prompt or logs.
true
