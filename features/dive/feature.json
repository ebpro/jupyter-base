{
  "id": "dive",
  "version": "1.0.0",
  "name": "Dive",
  "description": "Tool for exploring Docker image layers and analyzing image efficiency - excellent for teaching image optimization",
  "maintainer": {
    "name": "Emmanuel BRUNO",
    "email": "emmanuel.bruno@univ-tln.fr"
  },
  "platforms": ["linux"],
  "provides": ["dive"],
  "dependsOn": ["base-apt"],
  "options": {
    "version": {
      "type": "string",
      "default": "0.12.0",
      "description": "Dive version to install"
    }
  },
  "postInstallCheck": {
    "command": "dive --version",
    "description": "Verify dive is installed"
  }
}
