{
  "id": "code-server",
  "name": "code-server",
  "description": "Installs code-server (coder) from GitHub releases using artefacts/versions.json",
  "dependsOn": [
    "container-user",
    "node",
    "_lib/download-release"
  ],
  "options": {},
  "version": "0.1.0",
  "maintainer": {
    "name": "Emmanuel BRUNO",
    "email": "emmanuel.bruno@univ-tln.fr"
  },
  "provides": [
    "code-server"
  ],
  "postInstallCheck": {
    "command": "code-server --version"
  },
  "platforms": [
    "linux/amd64",
    "linux/arm64"
  ],
  "vscode": {
    "forwardPorts": [
      8080
    ]
  },
  "documentationURL": "./features/code-server/README.md"
}