{
  "id": "java-gradle",
  "name": "Gradle Build Tool",
  "version": "1.0.0",
  "description": "Installs Gradle build tool via SDKMAN",
  "dependsOn": [
    "java-sdkman"
  ],
  "maintainer": {
    "name": "Emmanuel BRUNO",
    "email": "emmanuel.bruno@univ-tln.fr"
  },
  "platforms": [
    "linux/amd64",
    "linux/arm64"
  ],
  "options": {
    "GRADLE_VERSION": {
      "type": "string",
      "default": "",
      "description": "Specific Gradle version to install, or empty for latest"
    }
  },
  "provides": [
    "gradle"
  ],
  "postInstallCheck": {
    "command": "gradle --version",
    "description": "Verify Gradle is available"
  },
  "vscode": {
    "extensions": [
      "vscjava.vscode-gradle"
    ]
  },
  "documentationURL": "./features/java-gradle/README.md"
}