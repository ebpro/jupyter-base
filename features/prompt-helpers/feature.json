{
  "name": "prompt-helpers",
  "version": "0.1.0",
  "maintainer": {
    "name": "Emmanuel BRUNO",
    "email": "emmanuel.bruno@univ-tln.fr"
  },
  "id": "prompt-helpers",
  "description": "Installs gitstatusd and related prompt helpers",
  "dependsOn": [
    "container-user",
    "_lib/download-release"
  ],
  "options": {},
  "postInstallCheck": {
    "command": "test -x /usr/local/bin/gitstatusd",
    "description": "Verify gitstatusd binary is installed and executable"
  },
  "documentationURL": "./features/prompt-helpers/README.md",
  "platforms": [
    "linux/amd64",
    "linux/arm64"
  ]
}
