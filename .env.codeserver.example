## Copy to .env.codeserver and edit values before running compose
# Domain that will be used to reach the codeserver (must resolve to this host)
TRAEFIK_DOMAIN=code.example.com
# Email used for Let's Encrypt registration (optional but recommended)
TRAEFIK_EMAIL=you@example.com

# If you want to use Let's Encrypt staging for testing, set:
# TRAEFIK_LETSENCRYPT_STAGING=1
