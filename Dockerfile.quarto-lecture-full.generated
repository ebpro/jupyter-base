
# --- Profile: quarto-lecture-full ---
FROM base AS profile-quarto-lecture-full
LABEL org.solen.profile="quarto-lecture-full" \
      org.solen.features.added="user _lib/download-release git-lfs python-base _lib/checksum-verify _lib/toolcache base-apt zsh-config startup docker-cli-helper python-conda quarto-common java-sdkman prompt-helpers gh-cli node kubernetes-client tilt pip-requirements dev-tools texlive postgresql-client jupyter-base quarto-cli java-maven java-gradle java-jdk python-lsp typescript kubernetes-dev postgresql-client-cli jupyter-kernels ml-python-packages quarto-python quarto-chromium react-tools java-kernel" \
      org.solen.features.provides="create-next-app,create-react-app,download_direct,download_github_release,gh,git-lfs,gradle,helm,java,javac,jupyter,jupyterlab,k9s,kubectl,kustomize,matplotlib,maven,mvn,node,npm,pandas,pg_dump,pg_isready,pg_restore,pgcli,pip,psql,python3,quarto-chromium,quarto-cli,quarto-python,scikit-learn,sdkman,seaborn,tilt,tsc,tsserver,vite"
ENV JDK_VERSION="25"
RUN \
  --mount=type=bind,source=.devcontainer/features/user,target=/tmp/features/user,readonly \
  --mount=type=bind,source=.devcontainer/features/_lib/download-release,target=/tmp/features/_lib/download-release,readonly \
  --mount=type=bind,source=.devcontainer/features/git-lfs,target=/tmp/features/git-lfs,readonly \
  --mount=type=bind,source=.devcontainer/features/python-base,target=/tmp/features/python-base,readonly \
  --mount=type=bind,source=.devcontainer/features/_lib/checksum-verify,target=/tmp/features/_lib/checksum-verify,readonly \
  --mount=type=bind,source=.devcontainer/features/_lib/toolcache,target=/tmp/features/_lib/toolcache,readonly \
  --mount=type=bind,source=.devcontainer/features/base-apt,target=/tmp/features/base-apt,readonly \
  --mount=type=bind,source=.devcontainer/features/zsh-config,target=/tmp/features/zsh-config,readonly \
  --mount=type=bind,source=.devcontainer/features/startup,target=/tmp/features/startup,readonly \
  --mount=type=bind,source=.devcontainer/features/docker-cli-helper,target=/tmp/features/docker-cli-helper,readonly \
  --mount=type=bind,source=.devcontainer/features/python-conda,target=/tmp/features/python-conda,readonly \
  --mount=type=bind,source=.devcontainer/features/quarto-common,target=/tmp/features/quarto-common,readonly \
  --mount=type=bind,source=.devcontainer/features/java-sdkman,target=/tmp/features/java-sdkman,readonly \
  --mount=type=bind,source=.devcontainer/features/prompt-helpers,target=/tmp/features/prompt-helpers,readonly \
  --mount=type=bind,source=.devcontainer/features/gh-cli,target=/tmp/features/gh-cli,readonly \
  --mount=type=bind,source=.devcontainer/features/node,target=/tmp/features/node,readonly \
  --mount=type=bind,source=.devcontainer/features/kubernetes-client,target=/tmp/features/kubernetes-client,readonly \
  --mount=type=bind,source=.devcontainer/features/tilt,target=/tmp/features/tilt,readonly \
  --mount=type=bind,source=.devcontainer/features/pip-requirements,target=/tmp/features/pip-requirements,readonly \
  --mount=type=bind,source=.devcontainer/features/dev-tools,target=/tmp/features/dev-tools,readonly \
  --mount=type=bind,source=.devcontainer/features/texlive,target=/tmp/features/texlive,readonly \
  --mount=type=bind,source=.devcontainer/features/postgresql-client,target=/tmp/features/postgresql-client,readonly \
  --mount=type=bind,source=.devcontainer/features/jupyter-base,target=/tmp/features/jupyter-base,readonly \
  --mount=type=bind,source=.devcontainer/features/quarto-cli,target=/tmp/features/quarto-cli,readonly \
  --mount=type=bind,source=.devcontainer/features/java-maven,target=/tmp/features/java-maven,readonly \
  --mount=type=bind,source=.devcontainer/features/java-gradle,target=/tmp/features/java-gradle,readonly \
  --mount=type=bind,source=.devcontainer/features/java-jdk,target=/tmp/features/java-jdk,readonly \
  --mount=type=bind,source=.devcontainer/features/python-lsp,target=/tmp/features/python-lsp,readonly \
  --mount=type=bind,source=.devcontainer/features/typescript,target=/tmp/features/typescript,readonly \
  --mount=type=bind,source=.devcontainer/features/kubernetes-dev,target=/tmp/features/kubernetes-dev,readonly \
  --mount=type=bind,source=.devcontainer/features/postgresql-client-cli,target=/tmp/features/postgresql-client-cli,readonly \
  --mount=type=bind,source=.devcontainer/features/jupyter-kernels,target=/tmp/features/jupyter-kernels,readonly \
  --mount=type=bind,source=.devcontainer/features/ml-python-packages,target=/tmp/features/ml-python-packages,readonly \
  --mount=type=bind,source=.devcontainer/features/quarto-python,target=/tmp/features/quarto-python,readonly \
  --mount=type=bind,source=.devcontainer/features/quarto-chromium,target=/tmp/features/quarto-chromium,readonly \
  --mount=type=bind,source=.devcontainer/features/react-tools,target=/tmp/features/react-tools,readonly \
  --mount=type=bind,source=.devcontainer/features/java-kernel,target=/tmp/features/java-kernel,readonly \
  --mount=type=bind,source=Artefacts,target=/tmp/Artefacts,readonly \
  --mount=type=bind,source=scripts,target=/tmp/scripts,readonly \
  --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  --mount=type=cache,target=/opt/toolcache,sharing=locked \
  --mount=type=cache,target=/root/.cache,sharing=locked \
  --mount=type=cache,target=/home/jovyan/.cache,sharing=locked,uid=1001,gid=1001 \
  bash -eux -o pipefail -c 'feats=("user" "_lib/download-release" "git-lfs" "python-base" "_lib/checksum-verify" "_lib/toolcache" "base-apt" "zsh-config" "startup" "docker-cli-helper" "python-conda" "quarto-common" "java-sdkman" "prompt-helpers" "gh-cli" "node" "kubernetes-client" "tilt" "pip-requirements" "dev-tools" "texlive" "postgresql-client" "jupyter-base" "quarto-cli" "java-maven" "java-gradle" "java-jdk" "python-lsp" "typescript" "kubernetes-dev" "postgresql-client-cli" "jupyter-kernels" "ml-python-packages" "quarto-python" "quarto-chromium" "react-tools" "java-kernel" ); for f in "${feats[@]}"; do \
    if [ -d "/tmp/features/$f" ]; then \
      chmod +x /tmp/features/$f/install.sh 2>/dev/null || true; \
      [ -f /tmp/features/$f/install.sh ] && { set +u; bash /tmp/features/$f/install.sh; set -u; }; \
    fi; \
  done; apt-get clean; rm -rf /var/lib/apt/lists/auxfiles /var/lib/apt/lists/lock /var/lib/apt/lists/partial'
FROM profile-quarto-lecture-full AS final
