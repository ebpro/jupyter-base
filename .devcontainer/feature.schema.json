{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Devcontainer feature.json schema",
  "description": "Schema for .devcontainer feature.json files used by the generator",
  "type": "object",
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "maintainer": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "email": {"type": "string"},
        "url": {"type": "string"}
      },
      "additionalProperties": false
    },
    "platforms": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tags": {"type": "array", "items": {"type": "string"}},
    "license": {"type": "string"},
    "options": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {"type": "string"},
          "default": {},
          "description": {"type": "string"},
          "env": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "caches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "description": {"type": "string"}
        },
        "required": ["id","path"]
      }
    },
    "provides": {"type": "array", "items": {"type": "string"}},
    "requires": {"type": "array", "items": {"type": "string"}},
    "postInstallCheck": {
      "type": "object",
      "properties": {
        "command": {"type": "string"},
        "path": {"type": "string"}
      },
      "additionalProperties": false
    },
    "runAs": {"type": "string", "enum": ["root","user","any"]}
  },
  "required": ["id","name","version"],
  "additionalProperties": true
}
