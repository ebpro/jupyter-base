{
  "name": "jupyter-base — Quarto dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "VARIANT": "ubuntu-24.04",
      "NB_USER": "jovyan",
      "NB_UID": "1001",
      "NB_GID": "1001",
      "QUARTO_VERSION": "1.8.24"
    }
  },
  "workspaceFolder": "/home/jovyan/work",
  "workspaceMount": "source=${localWorkspaceFolder}/work,target=/home/jovyan/work,type=bind,consistency=cached",
  "remoteUser": "jovyan",
  "postCreateCommand": "micromamba --version || true && quarto --version || true && quarto check install || true",
  "forwardPorts": [4200, 8888],
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-vscode-remote.remote-containers"
      ]
    }
  },
  "settings": {
    "terminal.integrated.defaultProfile.linux": "zsh"
  }
}
