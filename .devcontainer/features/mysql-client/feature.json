{
  "id": "mysql-client",
  "name": "MySQL Client Tools",
  "version": "1.1.0",
  "description": "MySQL/MariaDB client tools including mysql, mysqldump, and development libraries",
  "documentationURL": "https://dev.mysql.com/doc/refman/8.0/en/mysql.html",
  "licenseURL": "https://www.gnu.org/licenses/gpl-2.0.html",
  "dependsOn": [
    "base-apt"
  ],
  "options": {
    "clientType": {
      "type": "string",
      "enum": [
        "mysql",
        "mariadb"
      ],
      "default": "mysql",
      "description": "Client type to install (mysql or mariadb)"
    },
    "installLibmysqlclient": {
      "type": "boolean",
      "default": true,
      "description": "Install libmysqlclient-dev (MySQL C library headers for building extensions)"
    }
  },
  "provides": [
    "mysql",
    "mysqldump",
    "mysqladmin",
    "mysqlcheck",
    "mycli"
  ],
  "installsAfter": [
    "base-apt",
    "python-base"
  ],
  "vscode": {
    "extensions": [
      "cweijan.vscode-database-client2"
    ],
    "forwardPorts": [
      3306
    ]
  },
  "platforms": [
    "linux/amd64",
    "linux/arm64"
  ]
}
