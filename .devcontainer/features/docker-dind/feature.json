{
  "name": "docker-dind",
  "version": "0.1.0",
  "maintainer": {"name":"Emmanuel BRUNO","email":"emmanuel.bruno@univ-tln.fr"},
  "id": "docker-dind",
  "description": "Docker-in-Docker: Run Docker daemon inside the container for isolated container operations",
  "dependsOn": ["user"],
  "provides": ["docker", "docker-compose"],
  "options": {
    "enableBuildKit": {
      "type": "boolean",
      "default": true,
      "description": "Enable BuildKit for Docker builds"
    },
    "storageDriver": {
      "type": "string",
      "default": "overlay2",
      "description": "Docker storage driver (overlay2, vfs)"
    }
  },
  "postInstallCheck": {
    "command": "docker --version && docker-compose --version",
    "description": "Verify docker and docker-compose are available"
  }
}
