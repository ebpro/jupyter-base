{
  "name": "node",
  "version": "0.1.0",
  "maintainer": {"name":"Emmanuel BRUNO","email":"emmanuel.bruno@univ-tln.fr"},
  "id": "node",
  "description": "Installs Node.js (simple installer) or Volta if desired",
  "options": {
    "install_volta": {
      "type": "boolean",
      "default": false
    }
  }
  ,"provides": ["node","npm"],
  "postInstallCheck": {
    "command": "node --version && npm --version",
    "description": "Verify node and npm are available"
  },
  "platforms": ["linux/amd64","linux/arm64"],
  "maintainer": {"name":"Emmanuel BRUNO","email":"emmanuel.bruno@univ-tln.fr"}
}
