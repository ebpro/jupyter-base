{
  "name": "gh CLI",
  "version": "0.2.0",
  "maintainer": {"name":"Emmanuel BRUNO","email":"emmanuel.bruno@univ-tln.fr"},
  "provides": ["gh"],
  "dependsOn": ["_lib/download-release"],
  "postInstallCheck": {"command": "gh --version"},
  "platforms": ["linux/amd64","linux/arm64"],
  "id": "gh",
  "description": "Installs GitHub CLI into the dev user's bin using Artefacts/versions.json",
  "options": {},
  "vscode": {
    "extensions": [
      "github.vscode-pull-request-github",
      "github.copilot"
    ]
  }
}
