{
  "id": "typescript",
  "name": "TypeScript",
  "version": "1.0.0",
  "description": "Installs TypeScript compiler and type definitions globally via npm",
  "documentationURL": "https://www.typescriptlang.org/",
  "licenseURL": "https://github.com/microsoft/TypeScript/blob/main/LICENSE.txt",
  "maintainer": {"name":"Emmanuel BRUNO","email":"emmanuel.bruno@univ-tln.fr"},
  "dependsOn": ["node"],
  "options": {
    "version": {
      "type": "string",
      "default": "latest",
      "description": "TypeScript version to install (e.g., 5.7.2) or 'latest'"
    }
  },
  "provides": ["tsc", "tsserver"],
  "postInstallCheck": {
    "command": "tsc --version",
    "description": "Verify TypeScript is installed"
  },
  "platforms": ["linux/amd64","linux/arm64"]
}
