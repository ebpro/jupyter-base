{
  "id": "postgresql-client-cli",
  "name": "PostgreSQL Enhanced CLI",
  "version": "1.0.0",
  "description": "pgcli - Enhanced PostgreSQL CLI with autocomplete, syntax highlighting, and improved UX",
  "documentationURL": "https://www.pgcli.com/",
  "licenseURL": "https://github.com/dbcli/pgcli/blob/main/LICENSE.txt",
  "dependsOn": [
    "postgresql-client",
    "python-base"
  ],
  "provides": [
    "pgcli"
  ],
  "options": {},
  "postInstallCheck": {
    "command": "pgcli --version",
    "description": "Verify pgcli is installed"
  },
  "platforms": [
    "linux/amd64",
    "linux/arm64"
  ]
}
