# Purpose: Quarto lecture environment with Java, databases, and Docker-in-Docker for container demos

# Complete base system
bundle-base-full

# Development bundles
bundle-dev-base

# Notebooks and data science
bundle-data-science

# Quarto with TeX (for PDF output)
bundle-quarto-full
quarto-chromium

# Container CLI tools (docker, podman)
bundle-container-runtimes

# Java tooling for examples
bundle-java-build
java-jdk

# Auto-start services
startup

# Database clients for teaching
postgresql-client
python-db-dev

# Java Jupyter kernel
java-kernel

@options:JDK_VERSION=25
@options:INSTALL_NOTEBOOK_EXTENSIONS=true

# Services/Sidecars (un conteneur = un service)
@services:dind
@services:postgres:version=16
