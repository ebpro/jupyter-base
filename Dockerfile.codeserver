# Dockerfile.codeserver
# Builds a codeserver image. The base image is supplied via build arg `BASE_IMAGE`.
# This allows your `build.sh` to build the devcontainer image and pass its tag here.
ARG BASE_IMAGE="solen:dev"
FROM ${BASE_IMAGE}

ARG NB_USER="jovyan"
ARG NB_UID="1001"
ARG NB_GID="1001"

ARG TARGETPLATFORM

ENV HOME=/home/${NB_USER}

COPY --chown=root:root Artefacts/checksums.json /tmp/checksums.json
COPY --chown=root:root Artefacts/versions.json /tmp/versions.json

USER root
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends curl ca-certificates tar && rm -rf /var/lib/apt/lists/*


# Install code-server from GitHub release using pinned version from Artefacts/versions.json
RUN set -eux; \
    ARCH=$(case "${TARGETPLATFORM}" in \
        "linux/amd64") echo "amd64" ;; \
        "linux/arm64") echo "arm64" ;; \
        *) echo "amd64" ;; \
    esac); \
    CODE_SERVER_VERSION=$(jq -r '.tools["code-server"]' /tmp/versions.json); \
    echo "Installing code-server v${CODE_SERVER_VERSION} for arch ${ARCH}"; \
    CODE_URL="https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server-${CODE_SERVER_VERSION}-linux-${ARCH}.tar.gz"; \
    curl -fsSLo /tmp/code-server.tar.gz "${CODE_URL}"; \
    # If a checksum is present in the centralized checksums file, verify it
    if [ -f /tmp/checksums.json ]; then \
        CSUM=$(jq -r --arg t "code-server" --arg ver "${CODE_SERVER_VERSION}" --arg arch "${ARCH}" '.tools[$t].checksums[$ver][$arch] // empty' /tmp/checksums.json || true); \
        if [ -n "${CSUM}" ]; then echo "${CSUM}  /tmp/code-server.tar.gz" > /tmp/code-server.sha256 && sha256sum -c /tmp/code-server.sha256; fi; \
    fi; \
    mkdir -p /opt/code-server && tar -xzf /tmp/code-server.tar.gz -C /opt/code-server --strip-components=1 && rm /tmp/code-server.tar.gz; \
    ln -s /opt/code-server/bin/code-server /usr/local/bin/code-server || true; \
    chown -R ${NB_UID}:${NB_GID} /opt/code-server || true

USER ${NB_USER}

# Do not run code-server by default; this image installs it for use in devcontainers or by a separate runtime command
CMD ["/bin/bash"]
